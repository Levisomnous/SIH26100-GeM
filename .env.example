# Copy this file to .env and fill in your own values.
# .env is already git-ignored — never commit real credentials, and never
# paste them into a chat/issue/PR either.

# Postgres connection string (Supabase, RDS, local, etc.)
# If your password contains special characters like @ # : / ? — percent-encode
# them (@ -> %40, # -> %23) or the URL parser will silently truncate the
# string and drop everything after the special character.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@YOUR_HOST:5432/postgres

# --- Optional connection-pool tuning (defaults shown) ---
# DB_POOL_MIN=1            # connections kept open
# DB_POOL_MAX=10           # hard cap; keep below your provider's connection limit
# DB_POOL_WAIT=30          # seconds a request waits for a free connection
# DB_CONNECT_TIMEOUT=10    # seconds per connect attempt
# DB_CONNECT_RETRIES=5     # startup retries (exponential backoff)
# Supabase: use the pooled/"Session" connection string if you hit connection limits.

# --- Security (see README "Security & operations") ---
# Officer accounts: name:token pairs, tokens >= 16 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset the API runs in OPEN DEV MODE (no auth) and logs a warning.
# OFFICER_TOKENS=asha:PASTE_TOKEN_HERE,ravi:PASTE_ANOTHER_TOKEN_HERE
# Required to call DELETE /api/reset (which is off unless ENABLE_RESET=true):
# ADMIN_TOKEN=
# ENABLE_RESET=false
# APP_ENV=production          # refuses to start without OFFICER_TOKENS, forbids ENABLE_RESET
# MAX_UPLOAD_MB=10
# RATE_LIMIT_PER_MIN=30       # per client IP on write endpoints; 0 disables
# MAX_CONCURRENT_ANALYSIS=4   # simultaneous OCR/PDF analyses
# TRUST_PROXY=false           # true only behind a proxy that sets X-Forwarded-For

# --- Tests (they WIPE this database — never point it at real data) ---
# TEST_DATABASE_URL=postgresql://gem:gem@localhost:5433/gem_test
